---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__content">
      <div class="footer__about">
        <h3>Living To Die</h3>
        <p class="footer__text">
          A compelling story of hope, justice, and one woman's fight for patients' rights.
        </p>
      </div>

      <div class="footer__links">
        <h4>Quick Links</h4>
        <ul>
          <li><a href="/#summary">About the Book</a></li>
          <li><a href="/#author">About the Author</a></li>
          <li><a href="/resources">Resources</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <div class="footer__links">
        <h4>Connect</h4>
        <ul>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/contact">Speaking Requests</a></li>
          <li><a href="/#newsletter">Newsletter</a></li>
          <li>
            <a href="https://www.linkedin.com/in/diane-melton-189a07115/" target="_blank" rel="noopener noreferrer" class="footer__social">
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
              LinkedIn
            </a>
          </li>
          <li>
            <a href="https://www.facebook.com/profile.php?id=61589233803966" target="_blank" rel="noopener noreferrer" class="footer__social">
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07c0 6.02 4.39 11.02 10.13 11.93v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.7 4.53-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.61 23.09 24 18.09 24 12.07z"/></svg>
              Facebook
            </a>
          </li>
        </ul>
      </div>

      <div class="footer__newsletter">
        <h4>Stay Updated</h4>
        <p class="footer__text">Join our mailing list for book updates and events.</p>
        <form
          class="footer__form"
          id="newsletter-form"
          action="https://assets.mailerlite.com/jsonp/2188276/forms/181849541197170482/subscribe"
          method="POST"
        >
          <input type="hidden" name="ml-submit" value="1" />
          <input type="hidden" name="anticsrf" value="true" />
          <label for="footer-newsletter-name" class="sr-only">First name (optional)</label>
          <input
            id="footer-newsletter-name"
            type="text"
            name="fields[name]"
            placeholder="First name"
            autocomplete="given-name"
          />
          <label for="footer-newsletter-email" class="sr-only">Email address</label>
          <input
            id="footer-newsletter-email"
            type="email"
            name="fields[email]"
            placeholder="Your email"
            required
            autocomplete="email"
          />
          <button type="submit" class="btn btn--primary">Subscribe</button>
        </form>
        <p class="footer__success" id="newsletter-success" role="status" aria-live="polite">Please check your email to confirm.</p>
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; {currentYear} Diane Melton. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-pink-dark);
    color: white;
    padding: 3rem 0 2rem;
    margin-top: 5rem;
  }

  .footer__content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 2fr;
    gap: 3rem;
    margin-bottom: 2rem;
  }

  .footer h3, .footer h4 {
    color: white;
    margin-bottom: 1rem;
  }

  .footer__text {
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 1.5rem;
  }

  .footer__links ul {
    list-style: none;
    padding: 0;
  }

  .footer__links li {
    margin-bottom: 0.5rem;
  }

  .footer__links a {
    color: rgba(255, 255, 255, 0.7);
    transition: color var(--transition-fast);
  }

  .footer__links a:hover {
    color: white;
  }

  .footer__social {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer__social svg {
    flex-shrink: 0;
    opacity: 0.85;
  }

  .footer__form {
    display: flex;
    gap: 0.5rem;
  }

  .footer__form input {
    flex: 1;
    padding: 0.5rem 1.25rem;
    border: none;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.1);
    color: white;
  }

  .footer__form input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .footer__form input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    background: rgba(255, 255, 255, 0.15);
  }

  .footer__form button {
    padding: 0.5rem 1.25rem;
    background: var(--color-pink);
    border: none;
    color: white;
    font-weight: 600;
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }

  .footer__form button:hover {
    background: var(--color-soft-black);
    transform: translateY(-2px);
  }

  .footer__success {
    display: none;
    color: var(--color-accent);
    font-style: italic;
    margin-top: 0.75rem;
  }

  .footer__success.show {
    display: block;
  }

  .footer__form.hidden {
    display: none;
  }

  .footer__bottom {
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
    color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 768px) {
    .footer__content {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .footer__form {
      flex-direction: column;
    }
  }
</style>

<script>
  document.getElementById('newsletter-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const successEl = document.getElementById('newsletter-success');
    const btn = form.querySelector('button[type="submit"]');
    btn?.setAttribute('disabled', '');

    try {
      // Submit to MailerLite using no-cors mode (their API doesn't support CORS)
      await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        mode: 'no-cors'
      });

      // Hide form and show success message
      form.classList.add('hidden');
      successEl?.classList.add('show');
    } catch (error) {
      // Fallback: submit form normally if fetch fails
      form.submit();
    } finally {
      btn?.removeAttribute('disabled');
    }
  });
</script>
