---
import BaseLayout from '../layouts/BaseLayout.astro';
import Book3D from '../components/Book3D.astro';
import { getCollection } from 'astro:content';
import { getHomepageContent } from '../lib/content';

// Get featured resources for preview
const allResources = await getCollection('resources');
const previewResources = allResources.filter(r =>
  ['nbcf', 'komen', 'patient-advocate'].includes(r.slug)
);

// Get editable content (from Redis or defaults)
const content = await getHomepageContent();
---

<BaseLayout title="Home" description="Living To Die by Diane Melton tells a story of hope, medical negligence, and the fight for justice. A non-fiction account coming 2026." minimalNav={true}>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero__book">
      <Book3D />
    </div>
    <div class="hero__content">
      <span class="hero__badge">{content.hero_badge}</span>
      <h1 class="hero__title">{content.hero_title}</h1>
      <p class="hero__byline">By Diane Melton</p>
      <p class="hero__subtitle">
        {content.hero_subtitle}
      </p>
      <div class="hero__buttons">
        <a href="#preorder" class="btn btn--primary">Notify Me at Release</a>
        <a href="#author" class="btn btn--secondary">Meet the Author</a>
      </div>
      <p class="hero__note">A true story of hope, negligence &amp; justice</p>
    </div>
  </section>

  <!-- Pre-order Section -->
  <section class="section section--contrast" id="preorder">
    <div class="container preorder reveal">
      <div class="preorder__headline">
        <h2>{content.preorder_heading}</h2>
        <p>
          {content.preorder_text}
        </p>
      </div>
      <form
        class="preorder__form"
        id="preorder-form"
        action="https://assets.mailerlite.com/jsonp/2188276/forms/181849541197170482/subscribe"
        method="POST"
      >
        <input type="hidden" name="ml-submit" value="1" />
        <input type="hidden" name="anticsrf" value="true" />
        <div class="preorder__input-group">
          <input
            type="email"
            name="fields[email]"
            placeholder="Enter your email"
            required
            autocomplete="email"
          />
          <button type="submit" class="btn btn--primary">Notify Me</button>
        </div>
      </form>
      <p class="preorder__success" id="preorder-success">Please check your email to confirm.</p>
    </div>
  </section>

  <!-- Summary Section -->
  <section class="section" id="summary">
    <div class="container summary">
      <div class="summary__body reveal-left">
        <h2>{content.summary_heading}</h2>
        <p>
          {content.summary_paragraph1}
        </p>
        <p>
          {content.summary_paragraph2}
        </p>
      </div>
      <aside class="summary__highlights reveal-right">
        <h3>Key Themes</h3>
        <ul>
          <li>{content.theme1}</li>
          <li>{content.theme2}</li>
          <li>{content.theme3}</li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- Book Structure -->
  <section class="section section--muted" id="structure">
    <div class="container structure reveal-stagger">
      <div class="structure__card">
        <h3>{content.structure1_heading}</h3>
        <p>{content.structure1_text}</p>
      </div>
      <div class="structure__card">
        <h3>{content.structure2_heading}</h3>
        <p>{content.structure2_text}</p>
      </div>
      <div class="structure__card">
        <h3>{content.structure3_heading}</h3>
        <p>{content.structure3_text}</p>
      </div>
    </div>
  </section>

  <!-- Author Section -->
  <section class="section" id="author">
    <div class="container author">
      <div class="author__portrait reveal-left">
        <img src="/diane-melton.webp" alt="Diane Melton" />
        <p class="author__caption">Diane Melton</p>
      </div>
      <div class="author__bio reveal-right">
        <h2>About the Author</h2>
        <p>
          {content.author_bio1}
        </p>
        <p>
          {content.author_bio2}
        </p>
        <p>
          {content.author_bio3}
        </p>
      </div>
    </div>
  </section>

  <!-- Resources Preview -->
  <section class="section">
    <div class="container">
      <div class="section__header reveal">
        <h2 class="section__title">Resources & Support</h2>
        <p class="section__subtitle">
          Organizations and information for those affected by medical negligence and seeking advocacy support.
        </p>
      </div>

      <div class="resources-preview reveal-stagger">
        {previewResources.map(resource => (
          <a href={resource.data.url} target="_blank" rel="noopener" class="resource-preview-card">
            <div class="resource-preview__image">
              <img
                src={`/api/og-image?url=${encodeURIComponent(resource.data.url)}`}
                alt={resource.data.title}
                loading="lazy"
                onerror="this.src='https://images.unsplash.com/photo-1559757148-5c350d0d3c56?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&h=200&q=80'"
              />
            </div>
            <div class="resource-preview__content">
              <h3>{resource.data.title}</h3>
              <p>{resource.data.description}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-lg">
        <a href="/resources" class="btn btn--primary">View All Resources</a>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="section section--alt">
    <div class="container">
      <div class="newsletter reveal-scale">
        <div class="newsletter__content">
          <h2 class="newsletter__title">{content.newsletter_heading}</h2>
          <p class="newsletter__text">
            {content.newsletter_text}
          </p>
          <form
            class="newsletter__form"
            id="homepage-newsletter-form"
            action="https://assets.mailerlite.com/jsonp/2188276/forms/181849541197170482/subscribe"
            method="POST"
          >
            <input type="hidden" name="ml-submit" value="1" />
            <input type="hidden" name="anticsrf" value="true" />
            <input
              type="email"
              name="fields[email]"
              class="newsletter__input"
              placeholder="Enter your email"
              required
              autocomplete="email"
            />
            <button type="submit" class="btn btn--primary">Subscribe</button>
          </form>
          <p class="newsletter__success" id="homepage-newsletter-success">Please check your email to confirm.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Import new style system */
  @import '../styles/global-v2.css';

  /* Hero Section - Daylight (book left, copy right) */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 2.5rem;
    padding: 6.5rem 6vw 5rem;
    background:
      radial-gradient(ellipse 55% 65% at 26% 55%, rgba(214, 51, 132, 0.09), transparent 68%),
      radial-gradient(ellipse 70% 80% at 85% 15%, var(--color-cream), transparent 60%),
      linear-gradient(180deg, var(--color-soft-white) 0%, var(--color-blush) 100%);
    overflow: hidden;
  }

  .hero__book {
    position: relative;
    display: flex;
    justify-content: center;
    perspective: 2100px;
  }

  .hero__book::after {
    /* floor shadow ellipse */
    content: '';
    position: absolute;
    bottom: -5%;
    left: 50%;
    transform: translateX(-50%);
    width: 74%;
    height: 9%;
    background: radial-gradient(ellipse at center, rgba(70, 20, 45, 0.25), transparent 70%);
    filter: blur(7px);
  }

  .hero__book:hover :global(.book3d) {
    transform: rotateY(16deg) rotateX(1.5deg) translateY(-8px);
  }

  .hero__content {
    max-width: 620px;
  }

  .hero__badge {
    display: inline-block;
    padding: 0.5rem 1.4rem;
    background: var(--color-pink);
    color: white;
    border-radius: var(--radius-full);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    margin-bottom: var(--space-lg);
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6.2vw, 5.25rem);
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.02;
    text-transform: uppercase;
    color: var(--color-pink-dark);
    margin-bottom: var(--space-md);
  }

  .hero__byline {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--color-pink);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: var(--space-md);
  }

  .hero__subtitle {
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-style: italic;
    color: var(--color-warm-gray);
    max-width: 36ch;
    margin-bottom: var(--space-lg);
    line-height: var(--leading-relaxed);
    font-weight: 400;
  }

  .hero__buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero__note {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-lighter);
    margin-top: var(--space-lg);
    margin-bottom: 0;
  }

  /* Sections - Clean Publisher Style */
  .section {
    padding: var(--space-3xl) 0;
  }

  .section--alt {
    background: var(--color-pure-white);
  }

  .section--contrast {
    background: linear-gradient(135deg, #b8d4e3 0%, #9ac2d9 100%);
    color: var(--color-soft-black);
  }

  .section--muted {
    background: var(--color-beige);
  }

  .section__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section__title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-sage-dark);
    margin-bottom: var(--space-md);
  }

  .section__subtitle {
    font-size: 1.125rem;
    color: var(--color-text-light);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Pre-order Section */
  .preorder {
    text-align: center;
  }

  .preorder__headline h2 {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: white;
    margin-bottom: var(--space-md);
  }

  .preorder__headline p {
    font-size: 1.2rem;
    max-width: 600px;
    margin: 0 auto 2rem;
    color: var(--color-warm-gray);
  }

  .preorder__form {
    max-width: 500px;
    margin: 0 auto;
    min-height: 120px;
  }

  .preorder__form.hidden + .preorder__success {
    min-height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .preorder__input-group {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .preorder__input-group input[type="email"] {
    flex: 1;
    padding: 0.875rem 1rem;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.9);
    font-size: 1rem;
  }

  .preorder__input-group input[type="email"]:focus {
    outline: none;
    border-color: var(--color-primary);
    background: white;
  }

  .preorder__checkbox {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--color-warm-gray);
    font-size: 0.9rem;
    cursor: pointer;
  }

  .preorder__checkbox input[type="checkbox"] {
    width: 1rem;
    height: 1rem;
    cursor: pointer;
  }

  .preorder__success {
    display: none;
    color: var(--color-primary);
    font-weight: 500;
    margin-top: 1rem;
  }

  .preorder__success.show {
    display: block;
  }

  .preorder__form.hidden {
    display: none;
  }

  /* Summary Section */
  .summary {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .summary__body h2 {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: var(--color-sage-dark);
    margin-bottom: var(--space-lg);
    font-weight: 700;
  }

  .summary__body p {
    font-size: 1.15rem;
    margin-bottom: 2rem;
    color: var(--color-text-light);
  }

  .summary__highlights {
    background: var(--color-cream);
    padding: var(--space-lg);
    border-radius: var(--radius-xl);
    border-left: 4px solid var(--color-rose);
    box-shadow: var(--shadow-sm);
  }

  .summary__highlights h3 {
    color: var(--color-primary);
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
  }

  .summary__highlights ul {
    list-style: none;
    padding: 0;
  }

  .summary__highlights li {
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(108, 117, 125, 0.1);
    position: relative;
    padding-left: 1.5rem;
  }

  .summary__highlights li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: bold;
  }

  .summary__highlights li:last-child {
    border-bottom: none;
  }

  /* Structure Section */
  .structure {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .structure__card {
    background: var(--color-pure-white);
    padding: var(--space-xl);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    text-align: center;
    transition: all var(--transition-base);
    border-top: 3px solid var(--color-rose);
  }

  .structure__card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
  }

  .structure__card h3 {
    font-family: var(--font-display);
    color: var(--color-sage-dark);
    font-size: var(--text-xl);
    margin-bottom: var(--space-md);
    font-weight: 700;
  }

  .structure__card p {
    margin-bottom: 0;
    font-size: 1.1rem;
    color: var(--color-text-light);
  }

  /* Author Section */
  .author {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
    align-items: center;
  }

  .author__portrait img {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
  }

  .author__caption {
    text-align: center;
    margin-top: var(--space-md);
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-warm-gray);
    font-style: italic;
  }

  .author__bio h2 {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: var(--color-sage-dark);
    margin-bottom: var(--space-lg);
    font-weight: 700;
  }

  .author__bio p {
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
    color: var(--color-text-light);
  }

  .author__links {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  /* Blog Grid */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .blog-card {
    background: white;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-base);
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .blog-card__image {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .blog-card__content {
    padding: 1.5rem;
  }

  .blog-card__category {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--color-accent);
    color: white;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .blog-card__title {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .blog-card__title a {
    color: var(--color-primary);
  }

  .blog-card__excerpt {
    color: var(--color-text-light);
    margin-bottom: 1rem;
  }

  .blog-card__date {
    font-size: 0.875rem;
    color: var(--color-text-lighter);
  }

  /* Newsletter */
  .newsletter {
    background: var(--gradient-warm);
    border-radius: var(--radius-2xl);
    padding: var(--space-2xl);
    text-align: center;
    box-shadow: var(--shadow-lg);
  }

  .newsletter__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-sage-dark);
    margin-bottom: var(--space-sm);
  }

  .newsletter__text {
    color: var(--color-warm-gray);
    margin-bottom: var(--space-lg);
    font-size: var(--text-base);
  }

  .newsletter__form {
    display: flex;
    gap: 1rem;
    max-width: 500px;
    margin: 0 auto;
  }

  .newsletter__input {
    flex: 1;
    padding: 0.75rem 1.25rem;
    border: none;
    border-radius: var(--radius-md);
    font-size: 1rem;
  }

  .newsletter__input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .newsletter__success {
    display: none;
    color: var(--color-accent);
    font-style: italic;
    margin-top: 1rem;
  }

  .newsletter__success.show {
    display: block;
  }

  .newsletter__form.hidden {
    display: none;
  }

  /* Resources Preview */
  .resources-preview {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .resource-preview-card {
    background: white;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: all var(--transition-base);
  }

  .resource-preview-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
  }

  .resource-preview__image {
    height: 160px;
    overflow: hidden;
  }

  .resource-preview__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .resource-preview-card:hover .resource-preview__image img {
    transform: scale(1.05);
  }

  .resource-preview__content {
    padding: 1.5rem;
  }

  .resource-preview__content h3 {
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .resource-preview__content p {
    color: var(--color-text-light);
    font-size: 0.95rem;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 100svh;
      text-align: center;
      padding: 5.5rem 1.5rem 4rem;
      gap: 3.5rem;
    }

    .hero__content {
      margin: 0 auto;
      max-width: 100%;
    }

    .hero__subtitle {
      margin-left: auto;
      margin-right: auto;
    }

    .hero__book :global(.book3d) {
      --bk-w: min(62vw, 340px);
    }

    .hero__title {
      font-size: var(--text-3xl);
    }

    .hero__buttons {
      justify-content: center;
    }

    .summary {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .author {
      grid-template-columns: 1fr;
      gap: 3rem;
      text-align: center;
    }

    .preorder__input-group {
      flex-direction: column;
    }

    .preorder__input-group button {
      width: 100%;
    }

    .newsletter__form {
      flex-direction: column;
    }
  }
</style>

<script>
  // Newsletter form submission
  document.getElementById('homepage-newsletter-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const formData = new FormData(form);
    const successEl = document.getElementById('homepage-newsletter-success');

    try {
      await fetch(form.action, {
        method: 'POST',
        body: formData,
        mode: 'no-cors'
      });

      form.classList.add('hidden');
      successEl?.classList.add('show');
    } catch (error) {
      form.submit();
    }
  });

  // Preorder/Newsletter form
  document.getElementById('preorder-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const formData = new FormData(form);
    const successEl = document.getElementById('preorder-success');

    try {
      await fetch(form.action, {
        method: 'POST',
        body: formData,
        mode: 'no-cors'
      });

      form.classList.add('hidden');
      successEl?.classList.add('show');
    } catch (error) {
      form.submit();
    }
  });
</script>
