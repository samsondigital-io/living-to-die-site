---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getHomepageContent } from '../lib/content';
import { listResources } from '../lib/resources';

// Featured resources for the homepage preview. Same source order as
// /resources: Redis first (carries admin-curated card images), content
// collection as fallback — otherwise the preview scrapes og-images that
// don't match the curated cards.
const PREVIEW_DOMAINS = ['komen.org', 'nationalbreastcancer.org', 'patientadvocate.org'];

interface PreviewResource {
  title: string;
  description: string;
  url: string;
  imageUrl?: string;
}

let previewResources: PreviewResource[] = [];
try {
  const redisResources = await listResources();
  previewResources = PREVIEW_DOMAINS.flatMap(domain => {
    const match = redisResources.find(r => r.url.includes(domain));
    return match ? [{ title: match.title, description: match.description, url: match.url, imageUrl: match.imageUrl }] : [];
  });
} catch (error) {
  console.error('Redis unavailable for homepage resources preview, falling back:', error);
}

if (previewResources.length === 0) {
  const allResources = await getCollection('resources');
  previewResources = allResources
    .filter(r => ['nbcf', 'komen', 'patient-advocate'].includes(r.slug))
    .map(r => ({ title: r.data.title, description: r.data.description, url: r.data.url }));
}

// Get editable content (from Redis or defaults)
const content = await getHomepageContent();
---

<BaseLayout title="Home" description="Living To Die by Diane Melton tells a story of hope, medical negligence, and the fight for justice. A non-fiction account coming 2026." minimalNav={true}>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero__book">
      <img
        src="/book-cover-3d.webp"
        alt="Living To Die hardcover — black damask cover with a photograph of Brenda Sawicki, a pink ribbon, and the scales of justice"
        width="769"
        height="1157"
        fetchpriority="high"
      />
    </div>
    <div class="hero__content">
      <span class="hero__badge">{content.hero_badge}</span>
      <h1 class="hero__title">{content.hero_title}</h1>
      <p class="hero__byline">By Diane Melton</p>
      <p class="hero__subtitle">
        {content.hero_subtitle}
      </p>
      <div class="hero__buttons">
        <a href="#preorder" class="btn btn--primary">Pre-Order Your Copy</a>
        <a href="#author" class="btn btn--secondary">Meet the Author</a>
      </div>
      <p class="hero__note">A true story of hope, negligence &amp; justice</p>
    </div>
  </section>

  <!-- Pre-order Section -->
  <section class="section section--contrast" id="preorder">
    <div class="container preorder reveal">
      <div class="preorder__headline">
        <h2>{content.preorder_heading}</h2>
        <p>
          {content.preorder_text}
        </p>
      </div>
      <div class="preorder__buttons">
        <a
          href="https://www.warrenpublishing.net/store/p700/PRE-SALE_Living_to_Die_%28Hard_Cover%29_by_Diane_Melton.html"
          class="btn btn--primary"
          target="_blank"
          rel="noopener"
        >Pre-Order Hard Cover</a>
        <a
          href="https://www.warrenpublishing.net/store/p701/PRE-SALE_Living_to_Die_%28Soft_Cover%29_by_Diane_Melton.html"
          class="btn btn--primary"
          target="_blank"
          rel="noopener"
        >Pre-Order Soft Cover</a>
      </div>
    </div>
  </section>

  <!-- Summary Section -->
  <section class="section" id="summary">
    <div class="container summary">
      <div class="summary__body reveal-left">
        <h2>{content.summary_heading}</h2>
        <p>
          {content.summary_paragraph1}
        </p>
        <p>
          {content.summary_paragraph2}
        </p>
      </div>
      <div class="summary__side reveal-right">
        <aside class="themes">
          <h3>Key Themes</h3>
          <ul>
            <li>{content.theme1}</li>
            <li>{content.theme2}</li>
            <li>{content.theme3}</li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <!-- Book Structure -->
  <section class="section section--muted" id="structure">
    <div class="container">
      <div class="section__header reveal">
        <p class="eyebrow">About the Book</p>
        <h2 class="display">Inside these pages</h2>
      </div>
      <div class="structure reveal-stagger">
        <article class="structure__card">
          <span class="structure__chip" aria-hidden="true">1</span>
          <h3>{content.structure1_heading}</h3>
          <p>{content.structure1_text}</p>
        </article>
        <article class="structure__card">
          <span class="structure__chip" aria-hidden="true">2</span>
          <h3>{content.structure2_heading}</h3>
          <p>{content.structure2_text}</p>
        </article>
        <article class="structure__card">
          <span class="structure__chip" aria-hidden="true">3</span>
          <h3>{content.structure3_heading}</h3>
          <p>{content.structure3_text}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Author Section -->
  <section class="section" id="author">
    <div class="container author">
      <div class="author__portrait reveal-left">
        <img src="/diane-melton.webp" alt="Diane Melton" width="900" height="983" loading="lazy" />
        <p class="author__caption">Diane Melton</p>
      </div>
      <div class="author__bio reveal-right">
        <h2>About the Author</h2>
        <p>
          {content.author_bio1}
        </p>
        <p>
          {content.author_bio2}
        </p>
        <p>
          {content.author_bio3}
        </p>
      </div>
    </div>
  </section>

  <!-- Resources Preview -->
  <section class="section">
    <div class="container">
      <div class="section__header reveal">
        <h2 class="section__title">Resources & Support</h2>
        <p class="section__subtitle">
          Organizations and information for those affected by medical negligence and seeking advocacy support.
        </p>
      </div>

      <div class="resources-preview reveal-stagger">
        {previewResources.map(resource => (
          <a href={resource.url} target="_blank" rel="noopener noreferrer" class="resource-preview-card">
            <div class="resource-preview__image">
              <img
                src={resource.imageUrl && resource.imageUrl.trim() !== '' ? resource.imageUrl : `/api/og-image?url=${encodeURIComponent(resource.url)}`}
                alt={resource.title}
                width="400"
                height="200"
                loading="lazy"
                onerror="this.onerror=null;this.src='/images/resource-fallback.svg'"
              />
            </div>
            <div class="resource-preview__content">
              <h3>{resource.title}</h3>
              <p>{resource.description}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-lg">
        <a href="/resources" class="btn btn--primary">View All Resources</a>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="section section--alt" id="newsletter">
    <div class="container">
      <div class="newsletter reveal-scale">
        <div class="newsletter__content">
          <h2 class="newsletter__title">{content.newsletter_heading}</h2>
          <p class="newsletter__text">
            {content.newsletter_text}
          </p>
          <form
            class="newsletter__form"
            id="homepage-newsletter-form"
            action="/api/subscribe"
            method="POST"
          >
            <label for="homepage-newsletter-email" class="sr-only">Email address</label>
            <input
              id="homepage-newsletter-email"
              type="email"
              name="email"
              class="newsletter__input"
              placeholder="Enter your email"
              required
              autocomplete="email"
            />
            <button type="submit" class="btn btn--primary">Subscribe</button>
          </form>
          <p class="newsletter__success" id="homepage-newsletter-success" role="status" aria-live="polite">You're subscribed! We'll be in touch.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Import new style system */
  @import '../styles/global-v2.css';

  /* Hero Section - Daylight (book left, copy right) */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 2.5rem;
    padding: 6.5rem 6vw 5rem;
    background:
      radial-gradient(ellipse 55% 65% at 26% 55%, rgba(214, 51, 132, 0.09), transparent 68%),
      radial-gradient(ellipse 70% 80% at 85% 15%, var(--color-cream), transparent 60%),
      linear-gradient(180deg, var(--color-soft-white) 0%, var(--color-blush) 100%);
    overflow: hidden;
  }

  .hero__book {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .hero__book::after {
    /* contact shadow: tight dark core at the base, soft penumbra —
       grounds the book instead of letting it float */
    content: '';
    position: absolute;
    bottom: -1.5%;
    left: 51%;
    width: 78%;
    height: 6.5%;
    transform: translateX(-50%) rotate(-2deg);
    background: radial-gradient(ellipse 50% 55% at 50% 42%,
      rgba(35, 12, 24, 0.5) 0%,
      rgba(70, 20, 45, 0.24) 48%,
      transparent 74%);
    filter: blur(6px);
    z-index: 0;
    transition: transform 0.6s cubic-bezier(0.19, 1, 0.22, 1), opacity 0.6s ease;
  }

  .hero__book img {
    position: relative;
    z-index: 1;
    width: min(33vw, 500px);
    height: auto;
    transition: transform 0.6s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .hero__book:hover img {
    transform: translateY(-8px);
  }

  .hero__book:hover::after {
    transform: translateX(-50%) rotate(-2deg) scale(0.94);
    opacity: 0.75;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__book img { transition: none; }
  }

  .hero__content {
    max-width: 620px;
  }

  .hero__badge {
    display: inline-block;
    padding: 0.5rem 1.4rem;
    background: var(--color-pink);
    color: white;
    border-radius: var(--radius-full);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    margin-bottom: var(--space-lg);
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6.2vw, 5.25rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.02;
    text-transform: uppercase;
    color: var(--color-pink-dark);
    margin-bottom: var(--space-md);
  }

  .hero__byline {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--color-pink);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: var(--space-md);
  }

  .hero__subtitle {
    font-family: var(--font-body);
    font-size: 1.3rem;
    font-style: italic;
    color: var(--color-warm-gray);
    max-width: 36ch;
    margin-bottom: var(--space-lg);
    line-height: var(--leading-relaxed);
    font-weight: 400;
  }

  .hero__buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero__note {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-lighter);
    margin-top: var(--space-lg);
    margin-bottom: 0;
  }

  /* Sections - Clean Publisher Style */
  .section {
    padding: var(--space-3xl) 0;
  }

  .section--alt {
    background: var(--color-pure-white);
  }

  .section--contrast {
    /* deepest tone at the top edge so the band separates cleanly from the
       hero, which ends in the lighter blush */
    background: linear-gradient(180deg, #f3d5e6 0%, var(--color-blush-deep) 45%, var(--color-blush) 100%);
    border-top: 1px solid rgba(214, 51, 132, 0.16);
    color: var(--color-soft-black);
  }

  .section--muted {
    background: var(--color-blush);
  }

  .section__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section__title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-pink-dark);
    margin-bottom: var(--space-md);
  }

  .section__subtitle {
    font-size: 1.125rem;
    color: var(--color-text-light);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Pre-order Section */
  .preorder {
    text-align: center;
  }

  .preorder__headline h2 {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 600;
    color: var(--color-pink-dark);
    margin-bottom: var(--space-md);
  }

  .preorder__headline p {
    font-size: 1.2rem;
    max-width: 600px;
    margin: 0 auto 2rem;
    color: var(--color-warm-gray);
  }

  .preorder__buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Summary Section */
  .summary {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 5rem;
    align-items: center;
  }

  .summary__body h2 {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: var(--color-pink-dark);
    margin-bottom: var(--space-lg);
    font-weight: 600;
  }

  .summary__body p {
    font-size: 1.15rem;
    margin-bottom: 2rem;
    color: var(--color-text-light);
  }

  .themes {
    background: var(--color-blush);
    border-radius: 16px;
    padding: 2rem 2rem 1.5rem;
  }

  .themes h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-pink-dark);
    margin-bottom: 1rem;
  }

  .themes ul {
    list-style: none;
    padding: 0;
  }

  .themes li {
    font-size: 1rem;
    color: var(--color-text-light);
    padding: 0.7rem 0 0.7rem 1.9rem;
    position: relative;
  }

  .themes li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-pink);
    font-weight: bold;
  }

  /* Structure Section */
  .structure {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .structure__card {
    background: var(--color-pure-white);
    padding: 2.75rem 2.25rem 2.5rem;
    border-radius: 20px;
    box-shadow: var(--shadow-md);
    text-align: left;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .structure__card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-xl);
  }

  .structure__chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 12px;
    background: var(--gradient-chip);
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    box-shadow: 0 8px 16px -6px rgba(214, 51, 132, 0.5);
  }

  .structure__card h3 {
    font-family: var(--font-display);
    color: var(--color-pink-dark);
    font-size: 1.35rem;
    margin-bottom: var(--space-md);
    font-weight: 600;
  }

  .structure__card p {
    margin-bottom: 0;
    font-size: 1.1rem;
    color: var(--color-text-light);
  }

  /* Author Section */
  .author {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
    align-items: center;
  }

  .author__portrait {
    position: relative;
  }

  .author__portrait::before {
    content: '';
    position: absolute;
    inset: -1.75rem;
    border-radius: 50% 45% 55% 50% / 55% 50% 50% 45%;
    background: radial-gradient(circle at 30% 30%, var(--color-blush-deep), var(--color-blush) 70%);
    z-index: 0;
  }

  .author__portrait img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    border-radius: 18px;
    box-shadow: var(--shadow-xl);
  }

  .author__caption {
    position: relative;
    z-index: 1;
    text-align: center;
    margin-top: var(--space-md);
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-warm-gray);
    font-style: italic;
  }

  .author__bio h2 {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: var(--color-pink-dark);
    margin-bottom: var(--space-lg);
    font-weight: 600;
  }

  .author__bio p {
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
    color: var(--color-text-light);
  }

  .author__links {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  /* Newsletter */
  .newsletter {
    background: var(--gradient-warm);
    border-radius: 28px;
    padding: var(--space-2xl);
    text-align: center;
    box-shadow: var(--shadow-lg);
    position: relative;
    overflow: hidden;
  }

  .newsletter::before {
    content: '';
    position: absolute;
    top: -60px;
    right: -60px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(214, 51, 132, 0.12), transparent 70%);
  }

  .newsletter__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--color-pink-dark);
    margin-bottom: var(--space-sm);
  }

  .newsletter__text {
    color: var(--color-warm-gray);
    margin-bottom: var(--space-lg);
    font-size: var(--text-base);
  }

  .newsletter__form {
    display: flex;
    gap: 1rem;
    max-width: 500px;
    margin: 0 auto;
  }

  .newsletter__input {
    flex: 1;
    padding: 0.75rem 1.25rem;
    border: none;
    border-radius: var(--radius-md);
    font-size: 1rem;
  }

  .newsletter__input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .newsletter__success {
    display: none;
    color: var(--color-accent);
    font-style: italic;
    margin-top: 1rem;
  }

  .newsletter__success.show {
    display: block;
  }

  .newsletter__success.error {
    color: #b00020;
    font-style: normal;
  }

  .newsletter__form.hidden {
    display: none;
  }

  /* Resources Preview */
  .resources-preview {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .resource-preview-card {
    background: white;
    border-radius: 20px;
    border-top: 4px solid var(--color-pink);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .resource-preview-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
  }

  .resource-preview__image {
    height: 160px;
    overflow: hidden;
  }

  .resource-preview__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .resource-preview-card:hover .resource-preview__image img {
    transform: scale(1.05);
  }

  .resource-preview__content {
    padding: 1.5rem;
  }

  .resource-preview__content h3 {
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .resource-preview__content p {
    color: var(--color-text-light);
    font-size: 0.95rem;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 100svh;
      text-align: center;
      padding: 5.5rem 1.5rem 4rem;
      gap: 3.5rem;
    }

    .hero__content {
      margin: 0 auto;
      max-width: 100%;
    }

    .hero__subtitle {
      margin-left: auto;
      margin-right: auto;
    }

    .hero__book img {
      width: min(64vw, 360px);
    }

    .hero__title {
      font-size: var(--text-3xl);
    }

    .hero__buttons {
      justify-content: center;
    }

    .summary {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .author {
      grid-template-columns: 1fr;
      gap: 3rem;
      text-align: center;
    }

    .author__portrait {
      max-width: 380px;
      margin: 0 auto;
    }

    .preorder__buttons .btn {
      width: 100%;
    }

    .newsletter__form {
      flex-direction: column;
    }
  }
</style>

<script>
  // Newsletter signup: POST the email to /api/subscribe and show success/error.
  function wireForm(formId: string, statusId: string) {
    const form = document.getElementById(formId) as HTMLFormElement | null;
    const status = document.getElementById(statusId);
    const input = form?.querySelector('input[type="email"]') as HTMLInputElement | null;
    const btn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = input?.value?.trim();
      if (!email || !form || !status) return;
      btn?.setAttribute('disabled', '');
      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const data = await res.json();
        if (data.success) {
          form.classList.add('hidden');
          status.textContent = "You're subscribed! We'll be in touch.";
          status.classList.remove('error');
          status.classList.add('show');
        } else {
          status.textContent = data.error || 'Something went wrong. Please try again.';
          status.classList.add('show', 'error');
        }
      } catch {
        status.textContent = 'Something went wrong. Please try again.';
        status.classList.add('show', 'error');
      } finally {
        btn?.removeAttribute('disabled');
      }
    });
  }

  wireForm('homepage-newsletter-form', 'homepage-newsletter-success');
</script>
