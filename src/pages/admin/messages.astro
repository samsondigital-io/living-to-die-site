---
import { COOKIE_NAME, verifySessionToken } from '../../lib/auth';

if (!verifySessionToken(Astro.cookies.get(COOKIE_NAME)?.value)) {
  return Astro.redirect('/admin');
}
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Messages - Living to Die</title>
  <style is:global>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, -apple-system, sans-serif; background: #f8f9fa; min-height: 100vh; }
    .admin-layout { display: flex; min-height: 100vh; }
    .sidebar { width: 260px; background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%); color: white; padding: 1.5rem 0; display: flex; flex-direction: column; flex-shrink: 0; }
    .sidebar-header { padding: 0 1.5rem 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
    .sidebar-header h1 { font-size: 1.125rem; font-weight: 600; color: #d63384; }
    .sidebar-header span { font-size: 0.75rem; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 1px; }
    .sidebar-nav { flex: 1; padding: 1rem 0; }
    .nav-section { padding: 0.5rem 1.5rem; margin-bottom: 0.5rem; }
    .nav-section-title { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; color: rgba(255,255,255,0.4); margin-bottom: 0.75rem; }
    .nav-link { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; margin: 0.25rem 0; color: rgba(255,255,255,0.7); text-decoration: none; border-radius: 8px; font-size: 0.9rem; transition: all 0.2s; }
    .nav-link:hover { background: rgba(255,255,255,0.08); color: white; }
    .nav-link.active { background: rgba(214, 51, 132, 0.2); color: #d63384; }
    .nav-link.external { color: rgba(255,255,255,0.5); font-size: 0.8rem; }
    .sidebar-footer { padding: 1rem 1.5rem; border-top: 1px solid rgba(255,255,255,0.1); }
    .logout-link { display: flex; align-items: center; gap: 0.5rem; color: rgba(255,255,255,0.5); text-decoration: none; font-size: 0.85rem; }
    .logout-link:hover { color: white; }
    .main-content { flex: 1; padding: 2rem; overflow-y: auto; }
    .page-header { margin-bottom: 1.5rem; }
    .page-header h2 { font-size: 1.6rem; color: #333; margin-bottom: 0.25rem; }
    .page-header p { color: #666; font-size: 0.95rem; }
    .status { display: none; padding: 0.85rem 1rem; border-radius: 8px; margin-bottom: 1rem; font-size: 0.95rem; }
    .status.success { display: block; background: #e6f4ea; color: #1e7d34; }
    .status.error { display: block; background: #fdecea; color: #b3261e; }
    .toolbar { display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center; margin-bottom: 1.25rem; }
    .toolbar label { font-size: 0.9rem; font-weight: 600; color: #333; }
    .toolbar select { padding: 0.6rem 0.9rem; border: 1px solid #ddd; border-radius: 8px; font-size: 0.9rem; background: #fff; }
    .toolbar .count { font-size: 0.85rem; color: #888; margin-left: auto; }
    .msg { background: #fff; border: 1px solid #eee; border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 0.9rem; }
    .msg--unread { border-left: 4px solid #d63384; }
    .msg__head { display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.25rem; }
    .msg__name { font-weight: 600; color: #333; }
    .msg__email { color: #8B3A62; font-size: 0.85rem; text-decoration: none; word-break: break-all; }
    .msg__date { color: #888; font-size: 0.8rem; margin-left: auto; }
    .msg__subject { font-size: 0.8rem; font-weight: 600; color: #666; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.5rem; }
    .msg__body { white-space: pre-line; color: #444; line-height: 1.55; margin-bottom: 0.75rem; overflow-wrap: anywhere; }
    .msg__actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.7rem; font-weight: 600; background: #fde4f0; color: #b0256b; }
    .btn { padding: 0.4rem 0.9rem; border: none; border-radius: 6px; font-size: 0.8rem; cursor: pointer; font-weight: 500; text-decoration: none; display: inline-block; }
    .btn-reply { background: #d63384; color: #fff; }
    .btn-read { background: #e9e9e9; color: #333; }
    .btn-delete { background: #dc3545; color: #fff; }
    .btn:hover { filter: brightness(0.92); }
    .empty { color: #888; padding: 2.5rem 0; text-align: center; }
    @media (max-width: 768px) { .admin-layout { flex-direction: column; } .sidebar { width: 100%; } .main-content { padding: 1rem; } .msg__date { margin-left: 0; } }
  </style>
</head>
<body>
  <div class="admin-layout">
    <aside class="sidebar">
      <div class="sidebar-header">
        <span>Admin</span>
        <h1>Living to Die</h1>
      </div>
      <nav class="sidebar-nav">
        <div class="nav-section">
          <p class="nav-section-title">Overview</p>
          <a href="/admin/dashboard" class="nav-link">Dashboard</a>
        </div>
        <div class="nav-section">
          <p class="nav-section-title">Content</p>
          <a href="/admin" class="nav-link">Homepage</a>
          <a href="/admin/resources" class="nav-link">Resources</a>
          <a href="/admin/posts" class="nav-link">Blog Posts</a>
        </div>
        <div class="nav-section">
          <p class="nav-section-title">Communication</p>
          <a href="/admin/subscribers" class="nav-link">Subscribers</a>
          <a href="/admin/comments" class="nav-link">Comments</a>
          <a href="/admin/messages" class="nav-link active">Messages</a>
        </div>
        <div class="nav-section">
          <p class="nav-section-title">External</p>
          <a href="https://dashboard.mailerlite.com/" target="_blank" rel="noopener" class="nav-link external">MailerLite</a>
          <a href="/" target="_blank" class="nav-link external">View Website</a>
        </div>
      </nav>
      <div class="sidebar-footer">
        <a href="/admin/logout" class="logout-link">Sign Out</a>
      </div>
    </aside>

    <main class="main-content">
      <div class="page-header">
        <h2>Messages</h2>
        <p>Messages people send through the contact form on your website.</p>
      </div>

      <div id="status" class="status"></div>

      <div class="toolbar">
        <label for="read-filter">Show:</label>
        <select id="read-filter">
          <option value="all" selected>All</option>
          <option value="unread">Unread</option>
        </select>
        <span class="count" id="count"></span>
      </div>

      <div id="messages-container"></div>
    </main>
  </div>
  <script>
    interface ContactMessage {
      id: string;
      name: string;
      email: string;
      subject: string;
      message: string;
      read: boolean;
      createdAt: string;
    }

    function byId<T extends HTMLElement>(id: string): T {
      return document.getElementById(id) as T;
    }
    const container = byId<HTMLDivElement>('messages-container');
    const filter = byId<HTMLSelectElement>('read-filter');
    const count = byId<HTMLSpanElement>('count');
    const status = byId<HTMLDivElement>('status');
    let statusTimer: ReturnType<typeof setTimeout> | undefined;

    function showStatus(msg: string, type: 'success' | 'error') {
      status.className = 'status ' + type;
      status.textContent = msg;
      clearTimeout(statusTimer);
      statusTimer = setTimeout(() => { status.className = 'status'; }, 5000);
    }

    function escapeHtml(s: string): string {
      const map: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
      return String(s).replace(/[&<>"']/g, (c) => map[c] ?? c);
    }

    function fmtDate(d: string): string {
      const date = new Date(d);
      if (isNaN(date.getTime())) return '';
      return date.toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });
    }

    function replyLink(m: ContactMessage): string {
      const quoted = m.message.split('\n').map((l) => '> ' + l).join('\n');
      const params = new URLSearchParams({ subject: 'Re: ' + m.subject, body: '\n\n' + quoted });
      return 'mailto:' + encodeURIComponent(m.email) + '?' + params.toString().replace(/\+/g, '%20');
    }

    function errorMessage(err: unknown): string {
      return err instanceof Error ? err.message : String(err);
    }

    async function load() {
      try {
        const res = await fetch('/api/admin/messages', { credentials: 'same-origin' });
        const data: { success: boolean; data?: ContactMessage[]; error?: string } = await res.json();
        if (!data.success) throw new Error(data.error);
        const all = data.data ?? [];
        const unread = all.filter((m) => !m.read).length;
        const shown = filter.value === 'unread' ? all.filter((m) => !m.read) : all;
        count.textContent = `${all.length} message(s), ${unread} unread`;
        if (!shown.length) {
          container.innerHTML = '<div class="empty">No messages here.</div>';
          return;
        }
        container.innerHTML = shown.map((m) => `
          <div class="msg ${m.read ? '' : 'msg--unread'}" data-id="${escapeHtml(m.id)}" data-read="${m.read}">
            <div class="msg__head">
              <span class="msg__name">${escapeHtml(m.name)}</span>
              <a class="msg__email" href="mailto:${escapeHtml(m.email)}">${escapeHtml(m.email)}</a>
              ${m.read ? '' : '<span class="badge">New</span>'}
              <span class="msg__date">${fmtDate(m.createdAt)}</span>
            </div>
            <div class="msg__subject">${escapeHtml(m.subject)}</div>
            <div class="msg__body">${escapeHtml(m.message)}</div>
            <div class="msg__actions">
              <a class="btn btn-reply" href="${escapeHtml(replyLink(m))}" data-act="reply">Reply by email</a>
              <button class="btn btn-read" data-act="toggle">${m.read ? 'Mark as unread' : 'Mark as read'}</button>
              <button class="btn btn-delete" data-act="delete">Delete</button>
            </div>
          </div>`).join('');
      } catch (e) {
        container.innerHTML = '<div class="empty">Error loading messages.</div>';
        console.error(e);
      }
    }

    async function setRead(id: string, read: boolean) {
      const res = await fetch('/api/admin/messages/' + encodeURIComponent(id), {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ read }),
        credentials: 'same-origin',
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.error);
    }

    container.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-act]');
      const item = btn?.closest<HTMLElement>('.msg');
      if (!btn || !item) return;
      const id = item.dataset.id ?? '';
      const wasRead = item.dataset.read === 'true';
      try {
        if (btn.dataset.act === 'reply') {
          // Let the mail app open; quietly mark the message as handled.
          if (!wasRead) setRead(id, true).then(load).catch(() => {});
          return;
        }
        if (btn.dataset.act === 'toggle') {
          await setRead(id, !wasRead);
        } else if (btn.dataset.act === 'delete') {
          if (!confirm('Delete this message permanently?')) return;
          const res = await fetch('/api/admin/messages/' + encodeURIComponent(id), { method: 'DELETE', credentials: 'same-origin' });
          const data = await res.json();
          if (!data.success) throw new Error(data.error);
          showStatus('Message deleted.', 'success');
        }
        await load();
      } catch (err) {
        showStatus('Action failed: ' + errorMessage(err), 'error');
      }
    });

    filter.addEventListener('change', load);
    load();
  </script>
</body>
</html>
