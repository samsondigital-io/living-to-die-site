---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPostsByTag, getAllTags } from '../../../lib/blog';

const { tag } = Astro.params;
const posts = await getPostsByTag(tag!);
const allTags = await getAllTags();
const display = allTags.find((t) => t.key === tag)?.label ?? tag;

function fmtShort(d: Date) {
  return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---
<BaseLayout title={`#${display}`} description={`Posts tagged ${display}`} minimalNav={true}>
  <header class="blog-intro">
    <div class="container">
      <h1 class="blog-intro__title">{display}</h1>
      <p class="blog-intro__subtitle">{posts.length} post{posts.length === 1 ? '' : 's'} in this topic.</p>
    </div>
  </header>

  <section class="section section--muted">
    <div class="container">
      <nav class="topic-filters" aria-label="Filter by topic">
        <a href="/blog" class="topic-pill">All</a>
        {allTags.map((t) => (
          <a href={`/blog/tag/${encodeURIComponent(t.key)}`} class={`topic-pill ${t.key === tag ? 'topic-pill--active' : ''}`}>
            {t.label} <span class="topic-pill__count">{t.count}</span>
          </a>
        ))}
      </nav>

      {posts.length === 0 ? (
        <p class="blog-empty">No posts here yet. <a href="/blog">Back to all writing</a>.</p>
      ) : (
        <div class="card-grid">
          {posts.map((post) => (
            <a class="card" href={`/blog/${post.slug}`}>
              {post.heroImage ? (
                <div class="card__media"><img src={post.heroImage} alt={post.title} loading="lazy" /></div>
              ) : (
                <div class="card__media card__media--placeholder" aria-hidden="true"><span>{post.tags[0] || 'Living to Die'}</span></div>
              )}
              <div class="card__body">
                {post.tags.length > 0 && <span class="card__tag">{post.tags[0]}</span>}
                <h3 class="card__title">{post.title}</h3>
                <p class="card__excerpt">{post.description}</p>
                <div class="card__meta">
                  <time>{fmtShort(post.pubDate)}</time>
                  <span class="card__more">Read →</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-intro {
    padding: 8rem 0 4rem;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
    color: white;
    text-align: center;
  }
  .blog-intro__title { color: white; margin-bottom: 1rem; }
  .blog-intro__subtitle { font-size: 1.25rem; color: rgba(255, 255, 255, 0.9); max-width: 700px; margin: 0 auto; }

  .topic-filters {
    display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: center; margin-bottom: var(--space-2xl);
  }
  .topic-pill {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-warm-gray);
    text-decoration: none;
    padding: 0.5rem 1.1rem;
    background: var(--color-pure-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    transition: background-color 0.2s, border-color 0.2s, color 0.2s, transform 0.2s;
  }
  .topic-pill:hover { border-color: var(--color-pink); color: var(--color-pink); }
  .topic-pill--active { background: var(--color-pink); border-color: var(--color-pink); color: #fff; }
  .topic-pill__count { opacity: 0.6; font-size: 0.85em; margin-left: 0.15rem; }
  .topic-pill--active .topic-pill__count { opacity: 0.8; }

  .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-lg); }
  .card {
    display: flex; flex-direction: column; text-decoration: none;
    background: var(--color-pure-white); border: 1px solid var(--color-border);
    border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-sm);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .card:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); border-color: color-mix(in srgb, var(--color-pink) 35%, transparent); }
  .card__media { height: 180px; overflow: hidden; background: var(--color-blush); }
  .card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .card:hover .card__media img { transform: scale(1.05); }
  .card__media--placeholder { display: grid; place-items: center; background: radial-gradient(120% 120% at 20% 0%, var(--color-cream) 0%, var(--color-blush) 70%); }
  .card__media--placeholder span { font-family: var(--font-display); font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; letter-spacing: var(--tracking-wider); color: color-mix(in srgb, var(--color-pink) 65%, var(--color-warm-gray)); opacity: 0.7; }
  .card__body { padding: var(--space-lg); display: flex; flex-direction: column; flex: 1; }
  .card__tag { font-family: var(--font-display); font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: var(--tracking-wide); color: var(--color-pink); margin-bottom: 0.6rem; }
  .card__title { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 600; line-height: var(--leading-snug); color: var(--color-pink-dark); margin-bottom: 0.6rem; }
  .card__excerpt { font-family: var(--font-body); font-size: 1rem; line-height: var(--leading-relaxed); color: var(--color-warm-gray); margin-bottom: var(--space-md); flex: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .card__meta { display: flex; align-items: center; justify-content: space-between; padding-top: var(--space-md); border-top: 1px solid var(--color-border); font-family: var(--font-display); font-size: var(--text-sm); color: var(--color-light-gray); }
  .card__more { color: var(--color-pink); font-weight: 700; }
  .blog-empty { text-align: center; color: var(--color-light-gray); padding: var(--space-2xl) 0; }
</style>
