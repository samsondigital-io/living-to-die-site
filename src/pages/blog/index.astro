---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, getAllTags } from '../../lib/blog';

const posts = await getAllPosts();
const tags = await getAllTags();
const featured = posts.find((p) => p.featured) ?? posts[0] ?? null;
// "All Writing" lists the complete archive. When there are enough posts we drop
// the featured one from the grid to avoid duplication; with only a couple of
// posts we keep it so the grid never looks empty.
const rest = posts.length > 2 ? posts.filter((p) => p.slug !== featured?.slug) : posts;

function fmt(d: Date) {
  return new Date(d).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
function fmtShort(d: Date) {
  return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
const featuredInitial = (featured?.author || 'D').trim().charAt(0).toUpperCase();
---

<BaseLayout
  title="Blog"
  description="News, reflections, and insights from Diane Melton on the journey of bringing Living to Die to life."
  minimalNav={true}
>
  <!-- Intro -->
  <header class="blog-intro">
    <div class="container">
      <h1 class="blog-intro__title">Blog</h1>
      <p class="blog-intro__subtitle">
        News, reflections, and insights from the journey of bringing Living to Die to life.
      </p>

      {tags.length > 0 && (
        <nav class="topic-filters" aria-label="Filter by topic">
          <a href="/blog" class="topic-pill topic-pill--active">All</a>
          {tags.map((tag) => (
            <a href={`/blog/tag/${encodeURIComponent(tag.key)}`} class="topic-pill">
              {tag.label} <span class="topic-pill__count">{tag.count}</span>
            </a>
          ))}
        </nav>
      )}
    </div>
  </header>

  {featured && (
    <section class="section blog-featured-section">
      <div class="container">
        <a class="feature" href={`/blog/${featured.slug}`}>
          {featured.heroImage && (
            <div class="feature__media">
              <img src={featured.heroImage} alt={featured.title} loading="eager" />
            </div>
          )}
          <div class={`feature__body ${featured.heroImage ? '' : 'feature__body--full'}`}>
            <span class="feature__kicker">
              <span class="feature__pin">Featured</span>
              {featured.tags.length > 0 && <span class="feature__tag">{featured.tags[0]}</span>}
            </span>
            <h2 class="feature__title">{featured.title}</h2>
            <p class="feature__excerpt">{featured.description}</p>
            <div class="feature__meta">
              <span class="feature__avatar" aria-hidden="true">{featuredInitial}</span>
              <span class="feature__byline">{featured.author}</span>
              <span class="feature__dot">·</span>
              <time>{fmt(featured.pubDate)}</time>
            </div>
            <span class="feature__cta">Read the post →</span>
          </div>
        </a>
      </div>
    </section>
  )}

  <section class="section section--muted blog-list-section">
    <div class="container">
      {rest.length === 0 && !featured ? (
        <p class="blog-empty">No posts yet — check back soon.</p>
      ) : (
        <div class="card-grid">
          {rest.map((post) => (
            <a class="card" href={`/blog/${post.slug}`}>
              {post.heroImage ? (
                <div class="card__media">
                  <img src={post.heroImage} alt={post.title} loading="lazy" />
                </div>
              ) : (
                <div class="card__media card__media--placeholder" aria-hidden="true">
                  <span>{post.tags[0] || 'Living to Die'}</span>
                </div>
              )}
              <div class="card__body">
                {post.tags.length > 0 && <span class="card__tag">{post.tags[0]}</span>}
                <h3 class="card__title">{post.title}</h3>
                <p class="card__excerpt">{post.description}</p>
                <div class="card__meta">
                  <time>{fmtShort(post.pubDate)}</time>
                  <span class="card__more">Read →</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Intro: matches the site page-header style (resources-hero) ---------- */
  .blog-intro {
    padding: 8rem 0 4rem;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
    color: white;
    text-align: center;
  }
  .blog-intro__title {
    color: white;
    margin-bottom: 1rem;
  }
  .blog-intro__subtitle {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.9);
    max-width: 700px;
    margin: 0 auto;
  }

  /* ---------- Featured ---------- */
  .blog-featured-section { padding-top: var(--space-md); padding-bottom: var(--space-xl); }

  .feature {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: stretch;
    text-decoration: none;
    background: var(--color-pure-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .feature:hover { transform: translateY(-4px); box-shadow: var(--shadow-xl); }
  .feature__media { position: relative; min-height: 340px; background: var(--color-beige); }
  .feature__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .feature__body {
    padding: clamp(2rem, 4vw, 3.25rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .feature__body--full { max-width: 46rem; margin: 0 auto; }

  .feature__kicker { display: inline-flex; align-items: center; gap: 0.6rem; margin-bottom: var(--space-md); }
  .feature__pin {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-rose);
  }
  .feature__tag {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-light-gray);
    padding-left: 0.6rem;
    border-left: 1px solid var(--color-border);
  }
  .feature__title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-sage-dark);
    margin-bottom: var(--space-sm);
  }
  .feature__excerpt {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-warm-gray);
    margin-bottom: var(--space-lg);
  }
  .feature__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--color-light-gray);
    margin-bottom: var(--space-lg);
  }
  .feature__avatar {
    width: 34px; height: 34px;
    display: grid; place-items: center;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-rose), var(--color-rose-dark));
    color: #fff; font-weight: 600; font-size: 0.85rem;
    margin-right: 0.25rem;
  }
  .feature__byline { color: var(--color-warm-gray); font-weight: 600; }
  .feature__dot { opacity: 0.5; }
  .feature__cta {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-rose);
  }
  .feature:hover .feature__cta { color: var(--color-rose-dark); }

  /* ---------- List + filters ---------- */
  .blog-list-section { padding-top: var(--space-2xl); }

  /* Pills sit on the pink banner — light/translucent on pink, active = solid white */
  .topic-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    margin-top: 2rem;
  }
  .topic-pill {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    color: #fff;
    text-decoration: none;
    padding: 0.5rem 1.1rem;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: var(--radius-full);
    transition: all 0.2s;
  }
  .topic-pill:hover { background: rgba(255, 255, 255, 0.28); }
  .topic-pill--active { background: #fff; border-color: #fff; color: var(--color-rose-dark); }
  .topic-pill__count { opacity: 0.7; font-size: 0.85em; margin-left: 0.15rem; }

  /* ---------- Cards ---------- */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-lg);
  }
  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: var(--color-pure-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
    border-color: color-mix(in srgb, var(--color-rose) 35%, transparent);
  }
  .card__media { height: 180px; overflow: hidden; background: var(--color-beige); }
  .card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .card:hover .card__media img { transform: scale(1.05); }
  .card__media--placeholder {
    display: grid;
    place-items: center;
    background: radial-gradient(120% 120% at 20% 0%, var(--color-cream) 0%, var(--color-beige) 70%);
  }
  .card__media--placeholder span {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: color-mix(in srgb, var(--color-rose) 65%, var(--color-warm-gray));
    opacity: 0.7;
  }
  .card__body { padding: var(--space-lg); display: flex; flex-direction: column; flex: 1; }
  .card__tag {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-rose);
    margin-bottom: 0.6rem;
  }
  .card__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: var(--color-sage-dark);
    margin-bottom: 0.6rem;
  }
  .card__excerpt {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: var(--leading-relaxed);
    color: var(--color-warm-gray);
    margin-bottom: var(--space-md);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--color-light-gray);
  }
  .card__more { color: var(--color-rose); font-weight: 700; }

  .blog-empty { text-align: center; color: var(--color-light-gray); padding: var(--space-2xl) 0; }

  /* ---------- Responsive ---------- */
  @media (max-width: 860px) {
    .feature { grid-template-columns: 1fr; }
    .feature__media { min-height: 220px; }
  }
</style>
