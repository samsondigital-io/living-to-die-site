---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, getAllTags } from '../../lib/blog';

const posts = await getAllPosts();
const tags = await getAllTags();
const featured = posts.find((p) => p.featured) ?? posts[0] ?? null;
// Every post gets the same full-width card; the featured one (or the newest) leads.
const ordered = featured ? [featured, ...posts.filter((p) => p.slug !== featured.slug)] : posts;

function fmt(d: Date) {
  return new Date(d).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
const initial = (author: string) => (author || 'D').trim().charAt(0).toUpperCase();
---

<BaseLayout
  title="Blog"
  description="News, reflections, and insights from Diane Melton on the journey of bringing Living to Die to life."
  minimalNav={true}
>
  <!-- Intro -->
  <header class="blog-intro">
    <div class="container">
      <h1 class="blog-intro__title">Blog</h1>
      <p class="blog-intro__subtitle">
        News, reflections, and insights from the journey of bringing Living to Die to life.
      </p>

      {tags.length > 0 && (
        <nav class="topic-filters" aria-label="Filter by topic">
          <a href="/blog" class="topic-pill topic-pill--active">All</a>
          {tags.map((tag) => (
            <a href={`/blog/tag/${encodeURIComponent(tag.key)}`} class="topic-pill">
              {tag.label} <span class="topic-pill__count">{tag.count}</span>
            </a>
          ))}
        </nav>
      )}
    </div>
  </header>

  <section class="section blog-posts-section">
    <div class="container">
      {ordered.length === 0 ? (
        <p class="blog-empty">No posts yet — check back soon.</p>
      ) : (
        <div class="feature-stack">
          {ordered.map((post, i) => (
            <a class="feature" href={`/blog/${post.slug}`}>
              {post.heroImage && (
                <div class="feature__media">
                  <img src={post.heroImage} alt={post.title} loading={i === 0 ? 'eager' : 'lazy'} />
                </div>
              )}
              <div class={`feature__body ${post.heroImage ? '' : 'feature__body--full'}`}>
                <span class="feature__kicker">
                  {post === featured && <span class="feature__pin">Featured</span>}
                  {post.tags.length > 0 && (
                    <span class={`feature__tag ${post === featured ? '' : 'feature__tag--solo'}`}>{post.tags[0]}</span>
                  )}
                </span>
                <h2 class="feature__title">{post.title}</h2>
                {post.subtitle && <p class="feature__subtitle">{post.subtitle}</p>}
                <p class="feature__excerpt">{post.excerpt || post.description}</p>
                <div class="feature__meta">
                  <span class="feature__avatar" aria-hidden="true">{initial(post.author)}</span>
                  <span class="feature__byline">{post.author}</span>
                  <span class="feature__dot">·</span>
                  <time>{fmt(post.pubDate)}</time>
                </div>
                <span class="feature__cta">Read the post →</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Intro: matches the site page-header style (resources-hero) ---------- */
  .blog-intro {
    padding: 8rem 0 4rem;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
    color: white;
    text-align: center;
  }
  .blog-intro__title {
    color: white;
    margin-bottom: 1rem;
  }
  .blog-intro__subtitle {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.9);
    max-width: 700px;
    margin: 0 auto;
  }

  /* ---------- Posts: one full-width card each ---------- */
  .blog-posts-section { padding-top: var(--space-2xl); padding-bottom: var(--space-2xl); }
  .feature-stack { display: flex; flex-direction: column; gap: var(--space-xl); }

  .feature {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: stretch;
    text-decoration: none;
    background: var(--color-pure-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .feature:hover { transform: translateY(-4px); box-shadow: var(--shadow-xl); }
  .feature__media { position: relative; min-height: 340px; background: var(--color-blush); }
  /* Cards need a uniform frame, so photos are cropped — anchored near the top,
     where faces usually are in portrait shots, rather than the middle. */
  .feature__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 10%; }
  .feature__body {
    padding: clamp(2rem, 4vw, 3.25rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .feature__body--full { max-width: 46rem; margin: 0 auto; }

  .feature__kicker { display: inline-flex; align-items: center; gap: 0.6rem; margin-bottom: var(--space-md); }
  .feature__pin {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-pink);
  }
  .feature__tag {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-light-gray);
    padding-left: 0.6rem;
    border-left: 1px solid var(--color-border);
  }
  /* Without the "Featured" pin there's nothing to separate the tag from. */
  .feature__tag--solo { padding-left: 0; border-left: 0; }
  .feature__title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 600;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-pink-dark);
    margin-bottom: var(--space-sm);
  }
  .feature__subtitle {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-style: italic;
    line-height: var(--leading-snug);
    color: var(--color-warm-gray);
    margin-bottom: var(--space-sm);
  }
  .feature__excerpt {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-warm-gray);
    margin-bottom: var(--space-lg);
    /* Keep cards a similar height when a summary runs long. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .feature__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--color-light-gray);
    margin-bottom: var(--space-lg);
  }
  .feature__avatar {
    width: 34px; height: 34px;
    display: grid; place-items: center;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-pink), var(--color-pink-dark));
    color: #fff; font-weight: 600; font-size: 0.85rem;
    margin-right: 0.25rem;
  }
  .feature__meta { flex-wrap: wrap; }
  .feature__meta > * { white-space: nowrap; }
  .feature__byline { color: var(--color-warm-gray); font-weight: 600; }
  .feature__dot { opacity: 0.5; }
  .feature__cta {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-pink);
  }
  .feature:hover .feature__cta { color: var(--color-pink-dark); }

  /* ---------- Topic filters ---------- */

  /* Pills sit on the pink banner — light/translucent on pink, active = solid white */
  .topic-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    margin-top: 2rem;
  }
  .topic-pill {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    color: #fff;
    text-decoration: none;
    padding: 0.5rem 1.1rem;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: var(--radius-full);
    transition: background-color 0.2s, border-color 0.2s, color 0.2s, transform 0.2s;
  }
  .topic-pill:hover { background: rgba(255, 255, 255, 0.28); }
  .topic-pill--active { background: #fff; border-color: #fff; color: var(--color-pink-dark); }
  .topic-pill__count { opacity: 0.7; font-size: 0.85em; margin-left: 0.15rem; }

  .blog-empty { text-align: center; color: var(--color-light-gray); padding: var(--space-2xl) 0; }

  /* ---------- Responsive ---------- */
  @media (max-width: 860px) {
    .feature { grid-template-columns: 1fr; }
    .feature__media { min-height: 0; aspect-ratio: 4 / 3; }
  }
</style>
