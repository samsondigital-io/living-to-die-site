---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, normalizeTag } from '../../lib/blog';
import { getApprovedComments, createCommentToken, type Comment } from '../../lib/comments';

const { slug } = Astro.params;

// Find the unified post (repo or, in Plan B, redis). Repo posts also have a
// collection entry we render via <Content/>.
const allPosts = await getAllPosts();
const post = allPosts.find((p) => p.slug === slug);
if (!post) return Astro.redirect('/blog');

const allEntries = await getCollection('blog');
const entry = allEntries.find((p) => p.slug === slug);
let Content: any = null;
let bodyText = post.bodyHtml || '';
if (entry) {
  ({ Content } = await render(entry));
  bodyText = entry.body || '';
}

// Rough reading time from the raw source.
const words = (bodyText || '').replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(words / 200));

// Prev/next navigation (allPosts is newest-first). "newer" = earlier in array.
const idx = allPosts.findIndex((p) => p.slug === post.slug);
const newerPost = idx > 0 ? allPosts[idx - 1] : null;
const olderPost = idx >= 0 && idx < allPosts.length - 1 ? allPosts[idx + 1] : null;

const tags = post.tags;
const relatedPosts = allPosts
  .filter(
    (p) =>
      p.slug !== post.slug &&
      p.tags.some((t) => tags.some((et) => normalizeTag(et) === normalizeTag(t)))
  )
  .slice(0, 3);

const dateLong = new Date(post.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const authorInitial = (post.author || 'D').trim().charAt(0).toUpperCase();

let comments: Comment[] = [];
try {
  comments = await getApprovedComments(slug);
} catch (e) {
  console.error('Failed to load comments:', e);
}
const commentToken = createCommentToken();
---

<BaseLayout title={post.title} description={post.description} image={post.heroImage} minimalNav={true}>
  <article class="post">
    <!-- Simple back link (soft, in-flow — not a competing bar) -->
    <div class="post-backrow">
      <a href="/blog" class="post-back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"></path><path d="M12 19l-7-7 7-7"></path></svg>
        <span>All writing</span>
      </a>
    </div>

    <!-- Header -->
    <header class="post-head">
      <div class="post-head__inner">
        {tags.length > 0 && (
          <a href={`/blog/tag/${encodeURIComponent(normalizeTag(tags[0]))}`} class="post-eyebrow">{tags[0]}</a>
        )}
        <h1 class="post-title">{post.title}</h1>
        <p class="post-standfirst">{post.description}</p>

        <div class="post-byline">
          <span class="post-byline__avatar" aria-hidden="true">{authorInitial}</span>
          <div class="post-byline__meta">
            <span class="post-byline__name">{post.author}</span>
            <span class="post-byline__sub">
              <time datetime={new Date(post.pubDate).toISOString()}>{dateLong}</time>
              <span class="dot">·</span>
              {readingMinutes} min read
            </span>
          </div>
        </div>
      </div>
      <div class="post-rule" aria-hidden="true"></div>
    </header>

    {post.heroImage && (
      <figure class="post-hero">
        <img src={post.heroImage} alt={post.title} loading="eager" />
      </figure>
    )}

    <!-- Body -->
    <div class="post-body prose">
      {Content ? <Content /> : <Fragment set:html={post.bodyHtml} />}
    </div>

    <!-- Tags + share -->
    <div class="post-foot">
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag) => (
            <a href={`/blog/tag/${encodeURIComponent(normalizeTag(tag))}`} class="post-tag">#{tag}</a>
          ))}
        </div>
      )}
      <div class="post-share">
        <span class="post-share__label">Share</span>
        <a class="post-share__btn" aria-label="Share on X / Twitter" target="_blank" rel="noopener noreferrer"
           href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(Astro.url.href)}`}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2H21.5l-7.5 8.57L23 22h-6.86l-5.37-7.02L4.6 22H1.34l8.02-9.17L1 2h7.03l4.86 6.43L18.244 2Zm-1.2 18h1.9L7.04 4h-2L17.043 20Z"/></svg>
        </a>
        <a class="post-share__btn" aria-label="Share on Facebook" target="_blank" rel="noopener noreferrer"
           href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.9h2.54V9.85c0-2.52 1.5-3.91 3.78-3.91 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.44 2.9h-2.34V22c4.78-.79 8.43-4.94 8.43-9.94Z"/></svg>
        </a>
        <a class="post-share__btn" aria-label="Share on LinkedIn" target="_blank" rel="noopener noreferrer"
           href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(Astro.url.href)}&title=${encodeURIComponent(post.title)}`}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5ZM.2 8h4.6v14H.2V8Zm7.2 0h4.41v1.92h.06c.61-1.16 2.11-2.38 4.34-2.38 4.64 0 5.5 3.05 5.5 7.02V22h-4.6v-6.2c0-1.48-.03-3.38-2.06-3.38-2.06 0-2.38 1.61-2.38 3.27V22H7.4V8Z"/></svg>
        </a>
      </div>
    </div>

    <!-- Comments -->
    <section class="post-comments" id="comments">
      <h2 class="post-comments__title">Comments</h2>

      <div id="comments-list" class="comments-list">
        {comments.map((c) => (
          <article class="comment">
            <div class="comment__meta">
              <span class="comment__name">{c.name}</span>
              <time class="comment__date">{new Date(c.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
            </div>
            <p class="comment__body">{c.body}</p>
          </article>
        ))}
        {comments.length === 0 && <p class="comments-empty">No comments yet — be the first to share your thoughts.</p>}
      </div>

      <form class="comment-form" id="comment-form">
        <h3 class="comment-form__title">Leave a comment</h3>
        <input type="hidden" name="postSlug" value={slug} />
        <input type="hidden" name="token" value={commentToken} />
        <div class="comment-form__honeypot" aria-hidden="true">
          <label for="comment-website">Website</label>
          <input type="text" id="comment-website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <label class="sr-only" for="comment-name">Name</label>
        <input type="text" id="comment-name" name="name" placeholder="Your name" required maxlength="80" />
        <label class="sr-only" for="comment-body">Comment</label>
        <textarea id="comment-body" name="body" placeholder="Your comment…" required rows="4"></textarea>
        <button type="submit">Post comment</button>
        <p class="comment-form__status" id="comment-status" role="status" aria-live="polite"></p>
      </form>
    </section>

    <!-- Prev / next post navigation -->
    {(newerPost || olderPost) && (
      <nav class="post-pager" aria-label="Post navigation">
        {olderPost ? (
          <a class="post-pager__link post-pager__link--prev" href={`/blog/${olderPost.slug}`} rel="prev">
            <span class="post-pager__dir">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"></path><path d="M12 19l-7-7 7-7"></path></svg>
              Previous
            </span>
            <span class="post-pager__title">{olderPost.title}</span>
          </a>
        ) : <span class="post-pager__spacer"></span>}
        {newerPost ? (
          <a class="post-pager__link post-pager__link--next" href={`/blog/${newerPost.slug}`} rel="next">
            <span class="post-pager__dir">
              Next
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path></svg>
            </span>
            <span class="post-pager__title">{newerPost.title}</span>
          </a>
        ) : <span class="post-pager__spacer"></span>}
      </nav>
    )}

    {relatedPosts.length > 0 && (
      <section class="post-related">
        <h2 class="post-related__title">Keep reading</h2>
        <div class="post-related__grid">
          {relatedPosts.map((relPost) => (
            <a class="related-card" href={`/blog/${relPost.slug}`}>
              {relPost.tags.length > 0 && <span class="related-card__tag">{relPost.tags[0]}</span>}
              <h3 class="related-card__title">{relPost.title}</h3>
              <p class="related-card__excerpt">{relPost.description}</p>
              <span class="related-card__more">Read →</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <div class="post-endnav">
      <a href="/blog" class="post-endnav__link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"></path><path d="M12 19l-7-7 7-7"></path></svg>
        Back to all writing
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  /* ---- Layout scaffold ---- */
  .post {
    --measure: 40rem;
    --ink: #2e2a2c;            /* soft warm near-black, not #1a1a1a */
    --muted: var(--color-warm-gray);
    --rose: var(--color-pink);
    --paper: var(--color-soft-white);
    padding-bottom: 6rem;
    background:
      radial-gradient(120% 60% at 50% -10%, var(--color-cream) 0%, transparent 55%),
      var(--paper);
  }

  /* ---- Back link (soft, in-flow) ---- */
  .post-backrow {
    max-width: 58rem;
    margin: 0 auto;
    padding: 6rem clamp(1.25rem, 5vw, 2rem) 0;
  }
  .post-back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-accent);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-light-gray);
    text-decoration: none;
    transition: color 0.2s, gap 0.2s;
  }
  .post-back svg { width: 16px; height: 16px; transition: transform 0.2s; }
  .post-back:hover { color: var(--rose); gap: 0.65rem; }
  .post-back:hover svg { transform: translateX(-3px); }

  /* ---- Header ---- */
  .post-head {
    text-align: center;
    padding: clamp(2rem, 5vw, 3rem) clamp(1.25rem, 5vw, 2rem) 0;
    animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .post-head__inner { max-width: 46rem; margin: 0 auto; }

  .post-eyebrow {
    display: inline-block;
    font-family: var(--font-accent);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rose);
    text-decoration: none;
    padding: 0.35rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--rose) 35%, transparent);
    border-radius: 100px;
    margin-bottom: 1.6rem;
    transition: background 0.2s, color 0.2s;
  }
  .post-eyebrow:hover { background: var(--rose); color: #fff; }

  .post-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0 0 1.2rem;
    text-wrap: balance;
  }
  .post-standfirst {
    font-family: var(--font-body);
    font-style: italic;
    font-size: clamp(1.1rem, 2.2vw, 1.4rem);
    line-height: 1.5;
    color: var(--muted);
    max-width: 34rem;
    margin: 0 auto 2rem;
    text-wrap: balance;
  }

  .post-byline {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-align: left;
  }
  .post-byline__avatar {
    width: 42px; height: 42px;
    display: grid; place-items: center;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-pink) 0%, var(--color-pink-dark) 100%);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    box-shadow: 0 4px 14px color-mix(in srgb, var(--rose) 40%, transparent);
  }
  .post-byline__name {
    display: block;
    font-family: var(--font-accent);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink);
  }
  .post-byline__sub {
    display: block;
    font-family: var(--font-accent);
    font-size: 0.82rem;
    color: var(--color-light-gray);
  }
  .post-byline__sub .dot { margin: 0 0.4rem; }

  .post-rule {
    width: 60px; height: 3px;
    margin: 2.75rem auto 0;
    background: var(--rose);
    border-radius: 3px;
  }

  /* ---- Hero image ---- */
  .post-hero {
    margin: 2.75rem auto 0;
    max-width: 58rem;
    padding: 0 clamp(1.25rem, 5vw, 2rem);
  }
  .post-hero img {
    width: 100%;
    height: clamp(220px, 42vw, 460px);
    object-fit: cover;
    border-radius: 14px;
    box-shadow: 0 30px 60px -30px rgba(0,0,0,0.35);
  }

  /* ---- Prose ---- */
  .post-body {
    max-width: var(--measure);
    margin: clamp(2.5rem, 6vw, 4rem) auto 0;
    padding: 0 clamp(1.25rem, 5vw, 2rem);
    font-family: var(--font-body);
    font-size: 1.16rem;
    line-height: 1.85;
    color: var(--color-warm-gray);
    animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) 0.1s both;
  }

  .prose :global(p) { margin: 0 0 1.5rem; }

  /* Drop cap on the first paragraph */
  .prose :global(> p:first-of-type::first-letter) {
    float: left;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 3.6em;
    line-height: 0.78;
    padding: 0.05em 0.12em 0 0;
    color: var(--rose);
  }

  .prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 3.2rem 0 1.1rem;
    padding-top: 1.2rem;
    position: relative;
  }
  .prose :global(h2::before) {
    content: "";
    position: absolute;
    top: 0; left: 0;
    width: 36px; height: 3px;
    background: var(--rose);
    border-radius: 3px;
  }
  .prose :global(h3) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.2rem, 2.4vw, 1.45rem);
    color: var(--ink);
    margin: 2.4rem 0 0.8rem;
  }

  .prose :global(ul), .prose :global(ol) {
    margin: 0 0 1.6rem;
    padding-left: 1.5rem;
  }
  .prose :global(li) { margin-bottom: 0.6rem; padding-left: 0.4rem; }
  .prose :global(ul) { list-style: none; padding-left: 0.25rem; }
  .prose :global(ul > li) { position: relative; padding-left: 1.5rem; }
  .prose :global(ul > li::before) {
    content: "";
    position: absolute;
    left: 0; top: 0.72em;
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--rose);
  }
  .prose :global(strong) { color: var(--ink); font-weight: 700; }
  .prose :global(em) { font-style: italic; }

  .prose :global(a) {
    color: var(--color-pink-dark);
    text-decoration: none;
    background-image: linear-gradient(var(--rose), var(--rose));
    background-size: 100% 1px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: background-size 0.25s ease;
    padding-bottom: 1px;
  }
  .prose :global(a:hover) { background-size: 100% 100%; color: #fff; border-radius: 2px; padding: 0 2px; }

  .prose :global(blockquote) {
    margin: 2.4rem 0;
    padding: 1.4rem 1.8rem;
    border-left: 3px solid var(--rose);
    background: var(--color-blush);
    border-radius: 0 12px 12px 0;
    font-style: italic;
    font-size: 1.22rem;
    color: var(--color-warm-gray);
  }
  .prose :global(blockquote p:last-child) { margin-bottom: 0; }

  .prose :global(hr) {
    border: none;
    height: 1px;
    background: var(--color-border);
    margin: 3rem auto;
    width: 40%;
  }
  .prose :global(img) {
    width: 100%;
    border-radius: 12px;
    margin: 2rem 0;
  }

  /* ---- Foot: tags + share ---- */
  .post-foot {
    max-width: var(--measure);
    margin: 3.5rem auto 0;
    padding: 1.8rem clamp(1.25rem, 5vw, 2rem) 0;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
    justify-content: space-between;
  }
  .post-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .post-tag {
    font-family: var(--font-accent);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    padding: 0.35rem 0.75rem;
    border-radius: 100px;
    background: var(--color-blush);
    transition: background 0.2s, color 0.2s;
  }
  .post-tag:hover { background: var(--rose); color: #fff; }

  .post-share { display: inline-flex; align-items: center; gap: 0.6rem; }
  .post-share__label {
    font-family: var(--font-accent);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-light-gray);
  }
  .post-share__btn {
    width: 38px; height: 38px;
    display: grid; place-items: center;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    color: var(--muted);
    transition: background-color 0.2s, border-color 0.2s, color 0.2s, transform 0.2s;
  }
  .post-share__btn svg { width: 16px; height: 16px; }
  .post-share__btn:hover { background: var(--rose); color: #fff; border-color: var(--rose); transform: translateY(-2px); }

  /* ---- Related ---- */
  .post-related {
    max-width: 58rem;
    margin: 4.5rem auto 0;
    padding: 0 clamp(1.25rem, 5vw, 2rem);
  }
  .post-related__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.5rem;
    color: var(--ink);
    margin: 0 0 1.5rem;
    text-align: center;
  }
  .post-related__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }
  .related-card {
    display: block;
    text-decoration: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 1.5rem;
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
  }
  .related-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -24px rgba(0,0,0,0.3);
    border-color: color-mix(in srgb, var(--rose) 40%, transparent);
  }
  .related-card__tag {
    display: inline-block;
    font-family: var(--font-accent);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--rose);
    margin-bottom: 0.6rem;
  }
  .related-card__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    line-height: 1.25;
    color: var(--ink);
    margin: 0 0 0.5rem;
  }
  .related-card__excerpt {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--muted);
    margin: 0 0 0.9rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .related-card__more {
    font-family: var(--font-accent);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--rose);
  }

  /* ---- End nav ---- */
  .post-endnav {
    max-width: var(--measure);
    margin: 3.5rem auto 0;
    padding: 0 clamp(1.25rem, 5vw, 2rem);
    text-align: center;
  }
  .post-endnav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-accent);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink);
    text-decoration: none;
    padding: 0.8rem 1.6rem;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s, transform 0.2s;
  }
  .post-endnav__link svg { width: 18px; height: 18px; transition: transform 0.2s; }
  .post-endnav__link:hover { border-color: var(--rose); color: var(--rose); }
  .post-endnav__link:hover svg { transform: translateX(-4px); }

  /* ---- Prev / next pager ---- */
  .post-pager {
    max-width: var(--measure);
    margin: 3.5rem auto 0;
    padding: 0 clamp(1.25rem, 5vw, 2rem);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .post-pager__spacer { display: block; }
  .post-pager__link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.1rem 1.3rem;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    text-decoration: none;
    background: var(--color-surface);
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .post-pager__link--next { text-align: right; align-items: flex-end; }
  .post-pager__link:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 36px -24px rgba(0,0,0,0.3);
    border-color: color-mix(in srgb, var(--rose) 40%, transparent);
  }
  .post-pager__dir {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-accent);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rose);
  }
  .post-pager__dir svg { width: 15px; height: 15px; transition: transform 0.2s; }
  .post-pager__link--prev:hover .post-pager__dir svg { transform: translateX(-3px); }
  .post-pager__link--next:hover .post-pager__dir svg { transform: translateX(3px); }
  .post-pager__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.02rem;
    line-height: 1.3;
    color: var(--ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .post-pager { grid-template-columns: 1fr; }
    .post-pager__link--next { text-align: left; align-items: flex-start; }
    .post-pager__spacer { display: none; }
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .post-head, .post-body { animation: none; }
  }

  /* ---- Comments ---- */
  .post-comments { max-width: var(--measure); margin: 3.5rem auto 0; padding: 0 clamp(1.25rem, 5vw, 2rem); }
  .post-comments__title { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; color: var(--ink); margin-bottom: 1.25rem; }
  .comments-list { display: flex; flex-direction: column; gap: 1rem; }
  .comment { border: 1px solid var(--color-border); border-radius: 14px; padding: 1rem 1.25rem; background: var(--color-surface); }
  .comment__meta { display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 0.5rem; }
  .comment__name { font-family: var(--font-display); font-weight: 600; color: var(--rose); }
  .comment__date { font-size: 0.8rem; color: var(--muted); }
  .comment__body { white-space: pre-line; color: var(--ink); line-height: 1.6; margin: 0; }
  .comments-empty { color: var(--muted); }
  .comment-form { margin-top: 2rem; border: 1px solid var(--color-border); border-radius: 14px; padding: 1.5rem; background: var(--color-surface); }
  .comment-form__title { font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; color: var(--ink); margin-bottom: 1rem; }
  .comment-form__honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .comment-form input[type="text"], .comment-form textarea { width: 100%; padding: 0.75rem 1rem; border: 1px solid var(--color-border); border-radius: 8px; font-family: var(--font-body); font-size: 1rem; margin-bottom: 0.75rem; color: var(--ink); }
  .comment-form textarea { resize: vertical; min-height: 120px; }
  .comment-form input:focus, .comment-form textarea:focus { outline: 2px solid var(--rose); outline-offset: 1px; border-color: var(--rose); }
  .comment-form button { background: var(--rose); color: #fff; border: none; padding: 0.75rem 1.75rem; border-radius: 100px; font-weight: 600; font-size: 1rem; cursor: pointer; }
  .comment-form button:hover { filter: brightness(0.92); }
  .comment-form__status { margin-top: 0.75rem; font-size: 0.9rem; min-height: 1.2em; }
  .comment-form__status.success { color: #1e7b34; }
  .comment-form__status.error { color: #b3261e; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
</style>

<script>
  document.getElementById('comment-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const status = document.getElementById('comment-status');
    const btn = form.querySelector('button');
    btn?.setAttribute('disabled', '');
    if (status) { status.textContent = ''; status.className = 'comment-form__status'; }
    const fd = new FormData(form);
    try {
      const res = await fetch('/api/comments', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          postSlug: fd.get('postSlug'),
          name: fd.get('name'),
          body: fd.get('body'),
          website: fd.get('website'),
          token: fd.get('token'),
        }),
      });
      const data = await res.json();
      if (data.success) {
        form.reset();
        if (status) { status.textContent = 'Thank you! Your comment is awaiting approval.'; status.className = 'comment-form__status success'; }
      } else {
        if (status) { status.textContent = data.error || 'Could not post your comment.'; status.className = 'comment-form__status error'; }
      }
    } catch (err) {
      if (status) { status.textContent = 'Could not post your comment. Please try again.'; status.className = 'comment-form__status error'; }
    } finally {
      btn?.removeAttribute('disabled');
    }
  });
</script>
